/*
 * Prns for Haiku: the app's resources (signature, one instance, version).
 */

resource app_signature "application/x-vnd.prns";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 3,
	minor  = 8,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Prns",
	long_info = "Prns: the Reticulum daemon prnsd, its status and controls"
};
